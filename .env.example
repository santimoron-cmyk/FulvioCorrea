# Copy to .env (local) or define in Cloudflare Pages > Settings > Variables and Secrets.
# Never commit real values. Nothing here is embedded in the browser bundle except GTM_ID/GA4_ID.

# Build mode. Leave empty to use the automatic rule:
#   Cloudflare Pages branch "main" -> production; every other build -> preview (noindex).
# Set SITE_ENV=preview on Cloudflare to keep production deployments non-indexable until launch.
SITE_ENV=

# Runtime settings of the /api/lead Pages Function (functions/api/lead.js):
LEAD_WEBHOOK_URL=
LEAD_CAPTURE_ENABLED=false

# Optional analytics (loaded only after consent):
GTM_ID=
GA4_ID=
