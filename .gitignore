# Dependencies
node_modules/
.pnpm-store/

# This project is locked with pnpm (pnpm-lock.yaml). Cloudflare Pages picks the package
# manager from the lockfile, so a second lockfile must never be committed by accident.
package-lock.json
yarn.lock

# Environment / secrets (only .env.example with empty placeholders is versioned)
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
*.pem
*.key

# Build output (always regenerated by `npm run build`)
dist/

# Cloudflare / local tooling
.wrangler/
.sites-runtime/
.cache/

# Logs
*.log
logs/

# Backups / temporary files
backups/
*.tar.gz
*.zip
*.bak
*.tmp
*.backup-*.json
*~

# OS / editors
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
